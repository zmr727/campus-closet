.page {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.nav {
  padding: 88rpx 24rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.back {
  width: 56rpx;
  font-size: 48rpx;
  color: #333;
  text-align: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  margin-right: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.body {
  flex: 1;
  height: 0;
}

.block {
  margin: 24rpx;
}

.cover {
  width: 702rpx;
  height: 420rpx;
  border-radius: 20rpx;
  background: #f7f8fc;
}

.cover-empty {
  width: 702rpx;
  height: 420rpx;
  border-radius: 20rpx;
  background: #f7f8fc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 64rpx;
  color: #ff4768;
}

.plus-tip {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.form {
  padding: 0 24rpx;
}

.field {
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: row;
  align-items: center;
}

.field.col {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.field.col .label {
  margin-bottom: 16rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
}

.actions {
  margin: 36rpx 24rpx 0;
  display: flex;
  flex-direction: row;
}

.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  text-align: center;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.ghost {
  margin-right: 16rpx;
  background: #ffe6ea;
  color: #ff4768;
}

.btn.primary {
  background: #ff4768;
  color: #fff;
}

.bottom-space {
  height: 60rpx;
}
