<!-- 消息页 -->
<view class="page">
  <view class="header">
    <view class="title-row">
      <text class="title">消息</text>
      <text class="sub">按类型查看 ▾</text>
    </view>

    <view class="tabs">
      <view
        class="tab {{activeType === item.key ? 'on' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTab"
      >
        <text class="tab-text">{{item.label}}</text>
        <view class="badge" wx:if="{{badges[item.key] > 0}}">
          <text class="badge-text">{{badges[item.key] > 99 ? '99+' : badges[item.key]}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-bar">
    <text class="section-text">{{sectionTitle}}</text>
  </view>

  <view class="login-tip" wx:if="{{needLogin}}">
    <text class="login-tip-text">登录后可查看属于自己的消息</text>
    <view class="login-btn" bindtap="goLogin">去登录</view>
  </view>

  <view class="draft" wx:if="{{draft && !needLogin}}">
    <text class="draft-title">待发送咨询</text>
    <text class="draft-content">{{draft.content}}</text>
    <view class="draft-actions">
      <text class="btn ghost" bindtap="onClearDraft">取消</text>
      <text class="btn primary" bindtap="onSendDraft">发送给卖家</text>
    </view>
  </view>

  <scroll-view class="body" scroll-y show-scrollbar="{{false}}">
    <view class="empty" wx:if="{{!needLogin && !list.length && !oldList.length && !draft}}">
      <text>暂无{{sectionTitle}}</text>
    </view>

    <view
      class="item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="row">
        <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view class="info">
          <view class="top">
            <text class="name">{{item.name}}</text>
            <text class="time">{{item.time_label}}</text>
          </view>
          <view class="bottom">
            <text class="preview">{{item.preview}}</text>
            <view class="dot" wx:if="{{item.unread > 0}}">
              <text class="dot-text">{{item.unread}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="item fold-item" wx:if="{{oldList.length}}" bindtap="onToggleOld">
      <view class="row">
        <image class="fold-icon" src="/images/message/fold.png" mode="aspectFit"></image>
        <view class="info fold-main">
          <view class="fold-inner">
            <text class="fold-text">已折叠一周前的消息</text>
            <text class="fold-arrow">{{showOld ? '▲' : '▼'}}</text>
          </view>
        </view>
      </view>
    </view>

    <block wx:if="{{showOld}}">
      <view
        class="item"
        wx:for="{{oldList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpen"
      >
        <view class="row">
          <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="info">
            <view class="top">
              <text class="name">{{item.name}}</text>
              <text class="time">{{item.time_label}}</text>
            </view>
            <view class="bottom">
              <text class="preview">{{item.preview}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
