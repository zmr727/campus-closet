.page {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.nav {
  padding: 88rpx 24rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.back {
  width: 56rpx;
  font-size: 48rpx;
  color: #333;
  text-align: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  margin-right: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.body {
  flex: 1;
  height: 0;
}

.cover {
  width: 100%;
  height: 720rpx;
  background: #f2f2f2;
  display: block;
}

.main {
  padding: 28rpx 32rpx 16rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
}

.meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.nick {
  font-size: 26rpx;
  color: #ff4768;
  font-weight: 600;
}

.stat {
  font-size: 24rpx;
  color: #999;
}

.content {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

.link {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #fff0f3;
}

.link-text {
  font-size: 26rpx;
  color: #ff4768;
}

.section {
  margin-top: 12rpx;
  padding: 24rpx 32rpx;
  border-top: 16rpx solid #f7f8fc;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 16rpx;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}

.cmt {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.cmt-nick {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.cmt-text {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}

.cmt-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.bottom-space {
  height: 40rpx;
}

.composer {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  background: #fff;
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #f5f5f7;
  font-size: 28rpx;
}

.send {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ff4768;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
