.page {
  height: 100vh;
  background: #f7f8fc;
  display: flex;
  flex-direction: column;
}

.nav {
  padding: 88rpx 24rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fff;
}

.back {
  width: 56rpx;
  font-size: 48rpx;
  color: #333;
  text-align: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  margin-right: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.tabs {
  display: flex;
  flex-direction: row;
  background: #fff;
  padding: 0 24rpx 16rpx;
}

.tab {
  margin-right: 40rpx;
  font-size: 30rpx;
  color: #999;
  padding-bottom: 10rpx;
}

.tab.on {
  color: #ff4768;
  font-weight: 600;
  border-bottom: 6rpx solid #ff4768;
}

.status-scroll {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.status-row {
  display: inline-flex;
  flex-direction: row;
  padding: 16rpx 20rpx 20rpx;
}

.chip {
  display: inline-flex;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: #f2f2f4;
  font-size: 24rpx;
  color: #666;
}

.chip.on {
  background: #ffe6ea;
  color: #ff4768;
  font-weight: 600;
}

.body {
  flex: 1;
  height: 0;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.status {
  font-size: 28rpx;
  color: #ff4768;
  font-weight: 600;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.card-main {
  display: flex;
  flex-direction: row;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f2f2f4;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.price {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #ff4768;
  font-weight: 700;
}

.code-box {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #fff5f7;
}

.code-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.code-label {
  font-size: 26rpx;
  color: #999;
}

.code-num {
  margin-left: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ff4768;
  letter-spacing: 6rpx;
}

.code-copy {
  margin-left: auto;
  font-size: 24rpx;
  color: #ff4768;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #ffe6ea;
}

.code-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.verify-box {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
}

.verify-title {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.verify-input {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.card-actions {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.btn {
  margin-left: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
}

.btn.ghost {
  color: #666;
  background: #f2f2f4;
}

.btn.primary {
  color: #fff;
  background: #ff4768;
}

.peer-review {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #fff5f7;
  border: 1rpx solid rgba(255, 71, 104, 0.12);
}

.peer-title {
  display: block;
  font-size: 26rpx;
  color: #ff4768;
  font-weight: 600;
}

.peer-tags {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.peer-tag {
  margin: 0 12rpx 8rpx 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #ffe6ea;
  color: #ff4768;
  font-size: 22rpx;
}

.peer-content {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

.peer-content.muted {
  color: #bbb;
}

.bottom-space {
  height: 40rpx;
}
