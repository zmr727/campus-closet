.page {
  min-height: 100vh;
  background: #f7f8fc;
}

.nav {
  padding: 88rpx 24rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fff;
}

.back {
  width: 56rpx;
  font-size: 48rpx;
  color: #333;
  text-align: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  margin-right: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.body {
  padding: 24rpx;
}

.goods {
  display: flex;
  flex-direction: row;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
}

.cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #eee;
  flex-shrink: 0;
}

.goods-info {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
}

.peer {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.card {
  margin-top: 24rpx;
  padding: 32rpx 28rpx 40rpx;
  border-radius: 24rpx;
  background: #fff;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #444;
  font-weight: 600;
}

.label.mt {
  margin-top: 36rpx;
}

.stars {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.star {
  margin-right: 18rpx;
  font-size: 56rpx;
  color: #ddd;
  line-height: 1;
}

.star.on {
  color: #ff4768;
}

.score-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff4768;
}

.tags {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: #f2f2f4;
  font-size: 24rpx;
  color: #666;
}

.tag.on {
  background: #ffe6ea;
  color: #ff4768;
  font-weight: 600;
}

.area {
  margin-top: 16rpx;
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f7f8fc;
  font-size: 28rpx;
  color: #333;
}

.count {
  display: block;
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
}

.submit {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ff4768;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit.disabled {
  opacity: 0.45;
}

.done-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.done .stars {
  margin-top: 16rpx;
}

.done-content {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
}

.done-content.muted {
  color: #aaa;
}
