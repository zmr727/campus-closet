.page {
  min-height: 100vh;
  background: #fff;
  padding: 0 48rpx 80rpx;
  box-sizing: border-box;
}

.nav {
  height: 88rpx;
  margin-top: 88rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.nav-back {
  width: 64rpx;
  font-size: 56rpx;
  color: #333;
  text-align: center;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  pointer-events: none;
}

.avatar-block {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: #ffe6ea;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.section-title {
  margin-top: 48rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.preset-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.preset {
  width: 112rpx;
  height: 112rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
  border: 4rpx solid transparent;
}

.preset.on {
  border-color: #ff4768;
}

.preset-img {
  width: 100%;
  height: 100%;
}

.input {
  height: 88rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 32rpx;
}

.btn {
  margin-top: 64rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: rgb(255, 71, 104);
  color: #fff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
