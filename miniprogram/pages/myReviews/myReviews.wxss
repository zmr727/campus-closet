.page {
  height: 100vh;
  background: #f7f8fc;
  display: flex;
  flex-direction: column;
}

.nav {
  padding: 88rpx 24rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fff;
}

.back {
  width: 56rpx;
  font-size: 48rpx;
  color: #333;
  text-align: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  margin-right: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.summary {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 16rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.sum-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sum-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff4768;
}

.sum-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.sum-line {
  width: 1rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.08);
}

.tabs {
  margin-top: 16rpx;
  padding: 0 24rpx 12rpx;
  display: flex;
  flex-direction: row;
  background: #f7f8fc;
}

.tab {
  margin-right: 28rpx;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #999;
}

.tab.on {
  color: #ff4768;
  font-weight: 600;
  border-bottom: 6rpx solid #ff4768;
}

.empty {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 28rpx;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #bbb;
}

.body {
  flex: 1;
  height: 0;
  padding: 8rpx 24rpx 0;
  box-sizing: border-box;
}

.card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
}

.card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eee;
}

.who {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.role {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

.score {
  font-size: 28rpx;
  color: #ff4768;
  font-weight: 700;
}

.goods {
  margin-top: 16rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #f7f8fc;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: #eee;
  flex-shrink: 0;
}

.gtitle {
  margin-left: 14rpx;
  font-size: 26rpx;
  color: #555;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tags {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  margin: 0 12rpx 8rpx 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #ffe6ea;
  color: #ff4768;
  font-size: 22rpx;
}

.content {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}

.time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

.bottom-space {
  height: 40rpx;
}
