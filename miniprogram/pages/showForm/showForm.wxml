<!-- 晒买家秀 -->
<view class="page">
  <view class="nav">
    <view class="back" bindtap="onBack">‹</view>
    <text class="nav-title">晒买家秀</text>
  </view>

  <scroll-view class="body" scroll-y show-scrollbar="{{false}}">
    <view class="block" bindtap="onChooseCover">
      <image wx:if="{{coverLocal}}" class="cover" src="{{coverLocal}}" mode="aspectFill"></image>
      <view wx:else class="cover-empty">
        <text class="plus">＋</text>
        <text class="plus-tip">上传实拍穿搭</text>
      </view>
    </view>

    <view class="form">
      <view class="field">
        <text class="label">标题</text>
        <input class="input" placeholder="例如：买家秀·毕业季" value="{{title}}" bindinput="onTitle" />
      </view>
      <view class="field col">
        <text class="label">分享内容</text>
        <textarea class="textarea" placeholder="说说这次租赁体验吧" value="{{intro}}" bindinput="onIntro" maxlength="200"></textarea>
      </view>
    </view>

    <view class="actions">
      <view class="btn ghost" bindtap="onSaveDraft">存草稿</view>
      <view class="btn primary" bindtap="onSubmit">发布买家秀</view>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
