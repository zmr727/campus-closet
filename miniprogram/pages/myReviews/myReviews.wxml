<!-- 收到的评价 -->
<view class="page">
  <view class="nav">
    <view class="back" bindtap="onBack">‹</view>
    <text class="nav-title">收到的评价</text>
  </view>

  <view class="summary">
    <view class="sum-item">
      <text class="sum-num">{{avgAsSeller || '-'}}</text>
      <text class="sum-label">出借均分 · {{sellerCount}}条</text>
    </view>
    <view class="sum-line"></view>
    <view class="sum-item">
      <text class="sum-num">{{avgAsRenter || '-'}}</text>
      <text class="sum-label">租客均分 · {{renterCount}}条</text>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{role === 'all' ? 'on' : ''}}" data-role="all" bindtap="onRole">全部</view>
    <view class="tab {{role === 'seller' ? 'on' : ''}}" data-role="seller" bindtap="onRole">评我出借</view>
    <view class="tab {{role === 'renter' ? 'on' : ''}}" data-role="renter" bindtap="onRole">评我租用</view>
  </view>

  <view class="empty" wx:if="{{!list.length}}">
    <text>暂无收到评价</text>
    <text class="empty-tip">对方提交评价后会出现在这里</text>
  </view>

  <scroll-view class="body" scroll-y wx:else>
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="card-top">
        <image class="avatar" src="{{item.fromAvatar}}" mode="aspectFill"></image>
        <view class="who">
          <text class="name">{{item.fromName}}</text>
          <text class="role">{{item.roleLabel}}</text>
        </view>
        <text class="score">{{item.score}}星</text>
      </view>
      <view class="goods" data-id="{{item.clothesId}}" bindtap="onOpenGoods">
        <image class="cover" src="{{item.cover}}" mode="aspectFill"></image>
        <text class="gtitle">{{item.title}}</text>
      </view>
      <view class="tags" wx:if="{{item.tags.length}}">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
      </view>
      <text class="content" wx:if="{{item.content}}">{{item.content}}</text>
      <text class="time">{{item.timeText}}</text>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
