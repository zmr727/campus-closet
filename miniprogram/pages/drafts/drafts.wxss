.page {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.nav {
  padding: 88rpx 24rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.back {
  width: 56rpx;
  font-size: 48rpx;
  color: #333;
  text-align: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  margin-right: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.body {
  flex: 1;
  height: 0;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f7f8fc;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.del {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #ff4768;
}
