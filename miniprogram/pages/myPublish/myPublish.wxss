.page {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.nav {
  padding: 88rpx 24rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.back {
  width: 56rpx;
  font-size: 48rpx;
  color: #333;
  text-align: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  margin-right: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.tools {
  display: flex;
  flex-direction: row;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.tool {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  background: #ff4768;
  color: #fff;
  font-size: 28rpx;
}

.tool.ghost {
  background: #ffe6ea;
  color: #ff4768;
}

.body {
  flex: 1;
  height: 0;
}

.empty,
.loading {
  padding: 100rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #bbb;
  line-height: 1.5;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 24rpx 8rpx;
}

.card {
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  padding-bottom: 16rpx;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f7f8fc;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.ops {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  padding: 0 24rpx 8rpx;
  gap: 16rpx;
}

.op {
  min-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: #ffe6ea;
  color: #ff4768;
  font-size: 24rpx;
}

.op.danger {
  background: #fff;
  border: 1rpx solid rgba(255, 71, 104, 0.45);
}
