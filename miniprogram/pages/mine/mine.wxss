page {
  height: 100%;
  background: #ffffff;
}

.page {
  min-height: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: linear-gradient(180deg, #ffe6ea 0%, #ffffff 28%, #ffffff 100%);
  padding-bottom: 16rpx;
}

.header {
  flex-shrink: 0;
  padding: 96rpx 28rpx 20rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #000;
  line-height: 1.2;
}

.user-row {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.user-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #ffe6ea;
  flex-shrink: 0;
}

.user-mid {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nick-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.nickname {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #000;
  line-height: 1.2;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-tip {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #ff4768;
  flex-shrink: 0;
}

.role-tag {
  margin-top: 12rpx;
  display: inline-flex;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.role-text {
  font-size: 24rpx;
  color: #7c7c7c;
}

.user-right {
  flex-shrink: 0;
  align-items: flex-end;
  display: flex;
  flex-direction: column;
  margin-left: 12rpx;
}

.auth-title {
  font-size: 34rpx;
  color: #000;
  font-weight: 600;
}

.auth-id {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #7c7c7c;
}

.vip-card {
  flex-shrink: 0;
  margin: 40rpx 18rpx 0;
  padding: 40rpx 32rpx 36rpx;
  min-height: 220rpx;
  border-radius: 30rpx;
  background: #44424e;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.vip-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.vip-name {
  font-size: 36rpx;
  color: #e8b48a;
  font-weight: 600;
}

.vip-badge {
  padding: 4rpx 18rpx;
  border-radius: 10rpx;
  background: #e8b48a;
}

.vip-badge-text {
  font-size: 32rpx;
  color: #44424e;
  font-weight: 700;
}

.vip-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(232, 180, 138, 0.85);
  line-height: 1.4;
}

.vip-btn {
  margin: 28rpx auto 0;
  width: 236rpx;
  height: 64rpx;
  border-radius: 28rpx;
  background: #e8b48a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-btn-text {
  font-size: 34rpx;
  color: #44424e;
  font-weight: 600;
}

.vip-card.opened .vip-btn {
  background: rgba(232, 180, 138, 0.35);
}

.vip-card.opened .vip-btn-text {
  color: #e8b48a;
}

.order-card {
  flex-shrink: 0;
  margin: 28rpx 20rpx 0;
  padding: 22rpx 20rpx 20rpx;
  border-radius: 30rpx;
  background: #f7f8fc;
  box-sizing: border-box;
}

.order-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #44424e;
}

.order-all {
  font-size: 26rpx;
  color: #999;
}

.order-tabs {
  margin-top: 14rpx;
  margin-left: 12rpx;
  display: flex;
  flex-direction: row;
}

.otab {
  margin-right: 48rpx;
  padding-bottom: 10rpx;
  position: relative;
}

.otab-text {
  font-size: 32rpx;
  color: #7c7c7c;
}

.otab.on .otab-text {
  color: #ff4768;
  font-weight: 600;
}

.otab-badge {
  position: absolute;
  right: -28rpx;
  top: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #ff4768;
  border: 2rpx solid #f7f8fc;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.otab-badge-text {
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
  font-weight: 700;
}

.otab-line {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 8rpx;
  background: #ff4768;
  border-radius: 4rpx;
}

.order-icons {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 0 4rpx;
}

.oitem {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.oicon-wrap {
  position: relative;
  width: 92rpx;
  height: 92rpx;
}

.oicon {
  width: 92rpx;
  height: 92rpx;
}

.oicon-badge {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #ff4768;
  border: 3rpx solid #f7f8fc;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.oicon-badge-text {
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
  font-weight: 700;
}

.olabel {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7c7c7c;
}

.menu-card {
  flex-shrink: 0;
  margin: 24rpx 20rpx 28rpx;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  background: #f7f8fc;
  box-sizing: border-box;
}

.menu-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0;
  box-sizing: border-box;
}

.menu-text {
  font-size: 34rpx;
  color: #515151;
}

.menu-arrow {
  font-size: 40rpx;
  color: #c0c0c0;
  line-height: 1;
  flex-shrink: 0;
}

.menu-line {
  height: 1rpx;
  flex-shrink: 0;
  background: rgba(124, 124, 124, 0.4);
}
