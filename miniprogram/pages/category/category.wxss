.page {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  padding: 88rpx 28rpx 0;
}

.title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: #000;
  line-height: 1.2;
}

.sub {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: rgb(124, 124, 124);
}

.search-bar {
  margin: 20rpx 20rpx 0;
  height: 78rpx;
  border-radius: 40rpx;
  background: rgba(124, 124, 124, 0.15);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  opacity: 0.8;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 78rpx;
  font-size: 28rpx;
  color: #333;
}

.search-ph {
  color: rgba(124, 124, 124, 0.4);
}

.filters {
  margin: 18rpx 20rpx 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.filter-chip {
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  background: rgb(255, 230, 234);
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.filter-chip.wide {
  flex: 1;
  margin-right: 0;
  min-width: 0;
}

.rent-chip {
  justify-content: flex-start;
}

.filter-text {
  font-size: 26rpx;
  color: #ff4768;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.filter-arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #ff4768;
  line-height: 1;
}

.grid-scroll {
  flex: 1;
  height: 0;
  margin-top: 16rpx;
}

.grid {
  padding: 0 18rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 348rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: rgb(247, 248, 252);
  overflow: hidden;
}

.cover {
  width: 348rpx;
  height: 340rpx;
  display: block;
  background: #eee;
}

.info {
  padding: 14rpx 18rpx 20rpx;
}

.name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: rgb(3, 0, 1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.size {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgb(124, 124, 124);
}

.price {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #ff4768;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.bottom-space {
  height: 24rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 90;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

.cate-drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 280rpx;
  z-index: 100;
  background: #fff;
  box-shadow: 8rpx 0 24rpx rgba(0, 0, 0, 0.08);
  transform: translateX(-100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
  padding-top: 88rpx;
  box-sizing: border-box;
}

.cate-drawer.open {
  transform: translateX(0);
}

.cate-drawer-hd {
  padding: 20rpx 24rpx 12rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.cate-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.cate-list {
  flex: 1;
  height: 0;
}

.cate-item {
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: #444;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.cate-item.on {
  color: #ff4768;
  font-weight: 600;
  background: rgba(255, 71, 104, 0.06);
}

.rent-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(110%);
  transition: transform 0.25s ease;
}

.rent-sheet.open {
  transform: translateY(0);
}

.rent-sheet-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 28rpx;
}

.rent-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.rent-label {
  font-size: 28rpx;
  color: #333;
}

.rent-value {
  font-size: 28rpx;
  color: #ff4768;
}

.rent-summary {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.rent-actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
}

.rent-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  text-align: center;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.rent-btn.ghost {
  margin-right: 16rpx;
  background: #f5f5f5;
  color: #666;
}

.rent-btn.primary {
  background: #ff4768;
  color: #fff;
}
