<view class="page">
  <view class="nav">
    <view class="nav-back" bindtap="onBack">‹</view>
    <text class="nav-title">编辑资料</text>
  </view>

  <view class="avatar-block" bindtap="onPickAlbum">
    <image class="avatar" src="{{avatar}}" mode="aspectFill"></image>
    <text class="avatar-tip">点击更换头像（相册）</text>
  </view>

  <view class="section-title">选择默认头像</view>
  <view class="preset-grid">
    <view
      class="preset {{avatar === item ? 'on' : ''}}"
      wx:for="{{presets}}"
      wx:key="*this"
      data-src="{{item}}"
      bindtap="onPickPreset"
    >
      <image class="preset-img" src="{{item}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="section-title">昵称</view>
  <input
    class="input"
    placeholder="请输入昵称"
    maxlength="32"
    value="{{nickname}}"
    bindinput="onNick"
  />

  <view class="btn" bindtap="onSubmit">保存</view>
</view>
