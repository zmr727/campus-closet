.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 36rpx 40rpx;
  background: linear-gradient(180deg, #ffe6ea 0%, #ffffff 32%, #ffffff 100%);
}

.hero {
  padding: 0 4rpx 8rpx;
}

.hero-from {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1.15;
  letter-spacing: 1rpx;
}

.hero-title {
  display: block;
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #ff4768;
  line-height: 1.15;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  background: #ff4768;
}

.hero-tag-text {
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.2;
}

.card-hover {
  opacity: 0.88;
  transform: scale(0.985);
}

/* 主卡片 */
.card {
  margin-top: 36rpx;
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
}

.card.rent {
  margin-top: 40rpx;
  background: linear-gradient(180deg, #ffd0dc 0%, #ffe8ee 55%, #fff5f7 100%);
  min-height: 280rpx;
  padding: 52rpx 40rpx;
}

.card.show {
  background: #f3f4f8;
  min-height: 200rpx;
  padding: 44rpx 40rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.card-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.card-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1.25;
}

.card-title.sm {
  font-size: 36rpx;
}

.card-arrow {
  margin-left: 6rpx;
  font-size: 34rpx;
  color: #8a8a8a;
  line-height: 1;
  font-weight: 400;
}

.card-desc {
  display: block;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 1.4;
}

.card-desc.dark {
  margin-top: 24rpx;
  color: #8a8a8a;
}

.card-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #b0b0b0;
  line-height: 1.4;
}

/* 租 / 秀 徽章 */
.badge-rent {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ff9eb3;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.badge-rent-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.badge-show {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #ffe6ea;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.badge-show-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff4768;
  line-height: 1;
}

/* 底部双卡 */
.row-cards {
  margin-top: 36rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.mini {
  flex: 1;
  min-height: 268rpx;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
  position: relative;
}

.mini.rules {
  background: #fff6e8;
}

.mini.draft {
  background: #f0f1f8;
  padding-bottom: 72rpx;
}

.mini-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.mini-tag.orange {
  background: #ffba64;
}

.mini-tag.pink {
  background: #ffe6ea;
}

.mini-tag-text {
  font-size: 22rpx;
  color: #ffffff;
  line-height: 1.3;
}

.mini-tag-text.pink-t {
  color: #ff4768;
}

.mini-title {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1.3;
}

.mini-line {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  line-height: 1.4;
}

.draft-count {
  position: absolute;
  left: 24rpx;
  bottom: 28rpx;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  background: #ff4768;
}

.draft-count-text {
  font-size: 22rpx;
  color: #ffffff;
  line-height: 1.3;
}

.foot-tip {
  display: block;
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0b0b0;
  line-height: 1.4;
}
