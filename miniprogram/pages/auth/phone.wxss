/* padding 是内边距：盒子内部内容和边框之间的空隙 */
.page { min-height: 100vh; background: #fff; padding: 0 48rpx; }
.nav { height: 88rpx; margin-top: 88rpx; display: flex; align-items: center; position: relative; }
.nav-back { width: 64rpx; font-size: 56rpx; color: #333; text-align: center; }
/* pointer-events这个元素不接受点击 */
.nav-title { position: absolute; left: 0; right: 0;  text-align: center; font-size: 34rpx; font-weight: 600; pointer-events: none; }
.form { margin-top: 80rpx; }
.input { height: 88rpx; border-bottom: 1rpx solid #eee; font-size: 30rpx; margin-bottom: 24rpx; }
.code-row { display: flex; align-items: center; }
.flex { flex: 1; margin-bottom: 0; }
/* whitespace文字不换行 */
.code-btn { margin-left: 24rpx; font-size: 26rpx; color: rgb(255,71,104); white-space: nowrap; }
.btn { margin-top: 64rpx; height: 88rpx; border-radius: 44rpx; background: rgb(255,71,104); color: #fff; font-size: 34rpx; display: flex; align-items: center; justify-content: center; }
