<view class="page">
  <view class="nav">
    <view class="back" bindtap="onBack">‹</view>
    <text class="nav-title">我的发布</text>
  </view>

  <view class="tools">
    <view class="tool" bindtap="goPublish">去发布</view>
    <view class="tool ghost" bindtap="goDrafts">草稿箱</view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <text>还没有发布过服装</text>
    <text class="hint">点「去发布」上架后，可在这里修改或删除</text>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <scroll-view class="body" scroll-y wx:else>
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="row" data-id="{{item.id}}" bindtap="onEdit">
        <image class="thumb" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="info">
          <text class="title">{{item.title}}</text>
          <text class="sub">{{item.category}} · ￥{{item.price}}/天 · 收藏 {{item.fav_count || 0}}</text>
        </view>
      </view>
      <view class="ops">
        <view class="op" data-id="{{item.id}}" catchtap="onEdit">编辑</view>
        <view class="op danger" data-id="{{item.id}}" catchtap="onDelete">删除</view>
      </view>
    </view>
  </scroll-view>
</view>
