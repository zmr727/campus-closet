<view class="page">
  <view class="nav">
    <view class="back" bindtap="onBack">‹</view>
    <text class="nav-title">买家秀</text>
  </view>

  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero">
      <text class="hero-title">穿搭自由式</text>
      <text class="hero-sub">校园随心试 · 同学实拍分享</text>
    </view>

    <view class="grid">
      <view
        class="card"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTapItem"
      >
        <image class="cover" src="{{item.cover}}" mode="aspectFill"></image>
        <text class="name">{{item.title}}</text>
        <text class="intro">{{item.content || item.intro}}</text>
        <text class="meta">{{item.nickname}} · 评 {{item.comment_count || 0}}</text>
      </view>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
