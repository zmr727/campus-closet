.page {
  height: 100vh;
  background: #f5f6f8;
  display: flex;
  flex-direction: column;
}

.nav {
  padding: 88rpx 16rpx 16rpx;
  background: #fff;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.back {
  width: 64rpx;
  font-size: 48rpx;
  color: #333;
  text-align: center;
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.nav-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #eee;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.nav-right {
  width: 64rpx;
}

.body {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  margin: 8rpx 0 24rpx;
}

.bubble-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.bubble-row.me {
  justify-content: flex-end;
}

.side-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #eee;
  flex-shrink: 0;
}

.bubble {
  max-width: 520rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.bubble.mine {
  background: #ff4768;
  border-radius: 20rpx 8rpx 20rpx 20rpx;
}

.bubble-text {
  font-size: 28rpx;
  color: #222;
  line-height: 1.5;
}

.bubble.mine .bubble-text {
  color: #fff;
}

.pad {
  height: 20rpx;
}

.composer {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #f5f5f7;
  font-size: 28rpx;
}

.send {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ff4768;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
