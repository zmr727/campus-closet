<view class="page">
  <view class="nav">
    <view class="back" bindtap="onBack">‹</view>
    <text class="nav-title">我的收藏</text>
  </view>

  <view class="empty" wx:if="{{!list.length}}">
    <text>暂无收藏</text>
    <view class="go" bindtap="goHome">去首页逛逛</view>
  </view>

  <scroll-view class="body" scroll-y wx:else>
    <view class="row" wx:for="{{list}}" wx:key="id">
      <image
        class="thumb"
        src="{{item.cover}}"
        mode="aspectFill"
        data-id="{{item.id}}"
        bindtap="onOpen"
      ></image>
      <view class="info" data-id="{{item.id}}" bindtap="onOpen">
        <text class="title">{{item.title}}</text>
        <text class="sub">{{item.category || '可租'}} · ￥{{item.price}}/天</text>
      </view>
      <text class="del" data-id="{{item.id}}" catchtap="onRemove">取消</text>
    </view>
  </scroll-view>
</view>
