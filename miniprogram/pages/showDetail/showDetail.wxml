<!-- 买家秀详情 + 评论 -->
<view class="page">
  <view class="nav">
    <view class="back" bindtap="onBack">‹</view>
    <text class="nav-title">买家秀详情</text>
  </view>

  <scroll-view class="body" scroll-y show-scrollbar="{{false}}">
    <image class="cover" src="{{show.cover}}" mode="aspectFill"></image>

    <view class="main">
      <text class="title">{{show.title}}</text>
      <view class="meta">
        <text class="nick">{{show.nickname || '校园用户'}}</text>
        <text class="stat">赞 {{show.like_count || 0}} · 评 {{show.comment_count || 0}}</text>
      </view>
      <text class="content">{{show.content}}</text>
      <view class="link" wx:if="{{show.clothes_id}}" bindtap="onOpenClothes">
        <text class="link-text">查看关联租赁 ›</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">评论 {{comments.length}}</text>
      <view class="empty" wx:if="{{!comments.length}}">
        <text>还没有评论，来说两句吧</text>
      </view>
      <view class="cmt" wx:for="{{comments}}" wx:key="id">
        <text class="cmt-nick">{{item.nickname}}</text>
        <text class="cmt-text">{{item.content}}</text>
        <text class="cmt-time">{{item.created_at}}</text>
      </view>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>

  <view class="composer">
    <input
      class="input"
      placeholder="写评论…"
      value="{{commentText}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="onSendComment"
    />
    <view class="send" bindtap="onSendComment">发送</view>
  </view>
</view>
