.page {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.nav {
  padding: 88rpx 20rpx 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.back {
  width: 48rpx;
  height: 56rpx;
  font-size: 48rpx;
  line-height: 48rpx;
  color: #333;
  text-align: center;
  margin-right: 8rpx;
}

.search-bar {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(124, 124, 124, 0.1);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-btn {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #ff4768;
  font-weight: 600;
}

.body {
  flex: 1;
  height: 0;
}

.hint,
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.list {
  padding: 8rpx 24rpx;
}

.row {
  display: flex;
  flex-direction: row;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: #f7f8fc;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
}

.price {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #ff4768;
  font-weight: 600;
}

.bottom-space {
  height: 60rpx;
}
