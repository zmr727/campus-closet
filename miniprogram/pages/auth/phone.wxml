<view class="page">
  <view class="nav">
    <view class="nav-back" bindtap="onBack">‹</view>
    <text class="nav-title">手机号登录</text>
  </view>
  <!-- 把用户刚输入的内容存进 phone，后面点登录才能把手机号发给 login_phone.php -->
  <view class="form">
    <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
    <view class="code-row">
      <input class="input flex" type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onCode" />
      <view class="code-btn" bindtap="onSendCode">{{codeText}}</view>
    </view>
    <view class="btn" bindtap="onSubmit">登录</view>
  </view>
</view>
