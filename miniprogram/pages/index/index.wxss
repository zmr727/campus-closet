.page {
  min-height: 100vh;
  background: #ffffff;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* Logo + 搜索 */
.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 88rpx 24rpx 0;
}

.logo {
  height: 96rpx;
  width: 220rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.search-bar {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(124, 124, 124, 0.1);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 22rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.search-ph {
  font-size: 24rpx;
  color: rgb(124, 124, 124);
}

/* 校区 */
.campus-row {
  margin-top: 18rpx;
  padding: 0 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.campus-row:active {
  opacity: 0.7;
}

.campus-tri {
  font-size: 18rpx;
  color: rgb(124, 124, 124);
  margin-right: 10rpx;
  line-height: 1;
}

.campus-text {
  flex: 1;
  font-size: 28rpx;
  color: rgb(90, 90, 90);
}

.campus-more {
  font-size: 36rpx;
  color: rgba(124, 124, 124, 0.45);
  line-height: 1;
}

.divider {
  margin: 16rpx 22rpx 0;
  height: 1rpx;
  background: rgba(124, 124, 124, 0.2);
}

.banner-swiper {
  margin: 16rpx 22rpx 0;
  width: 706rpx;
  height: 456rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner {
  display: block;
  width: 706rpx;
  height: 456rpx;
}

.sec-head {
  margin-top: 28rpx;
  padding: 0 22rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.sec-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}

.sec-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.sec-more {
  font-size: 26rpx;
  color: rgba(124, 124, 124, 0.6);
}

.more-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 6rpx;
  opacity: 0.35;
}

.cal-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.cal-list {
  display: inline-flex;
  flex-direction: row;
  padding: 0 18rpx 8rpx;
  box-sizing: border-box;
}

.cal-card {
  width: 226rpx;
  height: 320rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: rgb(247, 248, 252);
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 14rpx 6rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.cal-date {
  width: 100%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  line-height: 1.2;
}

.cal-name {
  width: 100%;
  margin-top: 6rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgb(124, 124, 124);
  line-height: 1.2;
}

.cal-img-wrap {
  width: 100%;
  flex: 1;
  margin-top: 8rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.cal-img {
  width: 180rpx;
  height: 220rpx;
  display: block;
}

/* 双列瀑布流：左右两列各自往下接，中间不留大空 */
.water-wrap {
  margin: 16rpx 18rpx 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}

.water-col {
  width: 346rpx;
  display: flex;
  flex-direction: column;
}

/* 热租榜（可略高） */
.hot-card {
  width: 346rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  padding: 32rpx 20rpx 20rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(251, 184, 160, 0.95) 0%, rgba(255, 232, 206, 0.7) 100%);
}

.hot-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #000;
}

.hot-sub {
  display: block;
  margin-top: 10rpx;
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: rgba(124, 124, 124, 0.9);
  white-space: nowrap;
}

.hot-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.hot-thumb {
  width: 108rpx;
  height: 108rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.85);
  flex-shrink: 0;
}

.hot-name {
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #000;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
}

.goods-card {
  width: 346rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #f7f8fc;
  overflow: hidden;
}

.goods-img {
  width: 346rpx;
  height: 300rpx;
  display: block;
  background: #eee;
}

.goods-info {
  padding: 12rpx 14rpx 16rpx;
}

.goods-name {
  display: block;
  font-size: 26rpx;
  color: #000;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-price {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #ff4768;
}

.bottom-space {
  height: 40rpx;
}
