<!-- 聊天对话框 -->
<view class="page">
  <view class="nav">
    <view class="back" bindtap="onBack">‹</view>
    <view class="nav-center">
      <image class="nav-avatar" src="{{session.avatar}}" mode="aspectFill"></image>
      <text class="nav-title">{{session.name || '会话'}}</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <scroll-view
    class="body"
    scroll-y
    scroll-into-view="{{scrollInto}}"
    scroll-with-animation
  >
    <view class="tip">校园同校咨询 · 文明交流</view>

    <view
      class="bubble-row {{item.is_me ? 'me' : 'other'}}"
      wx:for="{{chats}}"
      wx:key="id"
      id="msg-{{item.id}}"
    >
      <image
        wx:if="{{!item.is_me}}"
        class="side-avatar"
        src="{{session.avatar}}"
        mode="aspectFill"
      ></image>
      <view class="bubble {{item.is_me ? 'mine' : ''}}">
        <text class="bubble-text">{{item.content}}</text>
      </view>
    </view>
    <view id="msg-bottom" class="pad"></view>
  </scroll-view>

  <view class="composer">
    <input
      class="input"
      placeholder="输入消息…"
      value="{{text}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSend"
    />
    <view class="send" bindtap="onSend">发送</view>
  </view>
</view>
